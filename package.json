{
  "name": "babili",
  "private": true,
  "version": "0.1.0",
  "description": "Babili multilingual restaurant ordering platform.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @babili/shared",
    "dev": "npm run dev --workspaces --if-present",
    "dev:shared": "npm run dev -w @babili/shared",
    "dev:web": "npm run dev -w @babili/web -- -p 3000",
    "dev:services": "node scripts/dev-services.mjs",
    "dev:gateway": "npm run dev -w @babili/api-gateway",
    "dev:auth": "npm run dev -w @babili/auth-service",
    "dev:restaurants": "npm run dev -w @babili/restaurant-service",
    "dev:orders": "npm run dev -w @babili/order-service",
    "dev:translations": "npm run dev -w @babili/translation-service",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:down": "npm run dev:docker:down",
    "prod:docker": "docker compose up --build",
    "prod:down": "docker compose down",
    "health": "node scripts/health-check.mjs",
    "pretypecheck": "npm run build -w @babili/shared",
    "pretest": "npm run build -w @babili/shared",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
